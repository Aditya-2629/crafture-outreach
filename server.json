{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "crafture-network-mcp",
  "title": "Crafture Network",
  "description": "Crafture Network — Multi-Channel Outreach Engine for LinkedIn & Email.",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/Aditya-2629/crafture-outreach",
  "repository": {
    "url": "https://github.com/Aditya-2629/crafture-outreach",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "crafture-network-mcp",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CRAFTURE_HOME",
          "description": "Directory for the local SQLite mirror and config. Defaults to ~/.crafture-network.",
          "format": "filepath",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
