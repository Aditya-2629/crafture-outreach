{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "outfox-mcp",
  "title": "OutFox",
  "description": "OutFox — Multi-Channel Outreach Engine for LinkedIn & Email.",
  "version": "1.0.0",
  "websiteUrl": "https://github.com/Aditya-2629/crafture-outreach",
  "repository": {
    "url": "https://github.com/Aditya-2629/crafture-outreach",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "linkedin-toolkit-mcp",
      "version": "2.1.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LINKEDIN_TOOLKIT_HOME",
          "description": "Directory for the local SQLite mirror and config. Defaults to ~/.linkedin-toolkit.",
          "format": "filepath",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
